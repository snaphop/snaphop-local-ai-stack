# ==============================================================================
# SnapHop Local AI Stack - Environment Configuration Template
# ==============================================================================

# Hugging Face Access Token (required to pull gated weights or checkpoints)
HF_TOKEN=your_huggingface_token_here

# Hardware & Engine Tuning (Optimized for NVIDIA GB10 Blackwell 121GB Unified Memory)
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
VLLM_GPU_MEMORY_UTILIZATION=0.72
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=64
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# Gateway & Security
LITELLM_PORT=4000
LITELLM_NUM_WORKERS=4
LITELLM_MASTER_KEY=REPLACE_WITH_UNIQUE_SECRET

# Database (PostgreSQL for LiteLLM UI, users, and API key management)
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_SECRET

# Admin Web UI Account (automatically bootstrapped on fresh setups)
LITELLM_ADMIN_EMAIL=admin@example.com
# Set a fixed password or leave unset to prompt/auto-generate on fresh setup
LITELLM_ADMIN_PASSWORD=

# Host Cache Mounts (Persists model shards and JIT/AOT compiled kernels)
HOST_CACHE_DIR_HF=~/.cache/huggingface
HOST_CACHE_DIR_VLLM=~/.cache/vllm
